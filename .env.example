# Copie para .env para personalizar. Não versionar o arquivo .env.
# Zeros iniciais exigidos no hash de cada bloco (prova de trabalho).
ECOORIGEM_DIFFICULTY=4
# Semente opcional para gerar carteiras reproduzíveis (somente desenvolvimento).
ECOORIGEM_DEMO_SEED=
# Porta da aplicação web e do nó (execução local, fora do Docker).
ECOORIGEM_WEB_PORT=5000
ECOORIGEM_NODE_PORT=8545
# Diretório de dados locais (cadeia e carteiras).
ECOORIGEM_DATA_DIR=data
# Logs coloridos (1 liga, 0 desliga).
ECOORIGEM_LOG_COLOR=1
